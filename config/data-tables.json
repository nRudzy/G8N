          "required": true
        },
        "classifier_version": {
          "type": "string",
          "required": true
        },
        "job_family": {
          "type": "string|null",
          "required": false
        },
        "is_tension_job": {
          "type": "boolean",
          "required": true
        },
        "confidence": {
          "type": "number",
          "required": true
        },
        "reasons_json": {
          "type": "string",
          "required": true
        },
        "classified_at": {
          "type": "datetime_utc",
          "required": true
        }
      }
    },
    {
      "name": "company_signals",
      "upsert_key": "signal_key",
      "columns": {
        "signal_key": {
          "type": "string",
          "required": true
        },
        "company_key": {
          "type": "string",
          "required": true
        },
        "window_key": {
          "type": "string",
          "required": true,
          "values": [
            "24h",
            "7d",
            "30d",
            "90d"
          ]
        },
        "signal_version": {
          "type": "string",
          "required": true
        },
        "active_offer_count": {
          "type": "integer",
          "required": true
        },
        "declared_position_count": {
          "type": "integer",
          "required": true
        },
        "job_family_count": {
          "type": "integer",
          "required": true
        },
        "site_count": {
          "type": "integer",
          "required": true
        },
        "republication_count": {
          "type": "integer",
          "required": true
        },
        "confidence": {
          "type": "number",
          "required": true
        },
        "computed_at": {
          "type": "datetime_utc",
          "required": true
        }
      }
    },
    {
      "name": "lead_scores",
      "upsert_key": "score_key",
      "columns": {
        "score_key": {
          "type": "string",
          "required": true
        },
        "company_key": {
          "type": "string",
          "required": true
        },
        "score_version": {
          "type": "string",
          "required": true
        },
        "priority_label": {
          "type": "string",
          "required": true,
          "values": [
            "Chaud",
            "À qualifier",
            "Veille",
            "Écarté"
          ]
        },
        "score": {
          "type": "number",
          "required": true
        },
        "confidence": {
          "type": "number",
          "required": true
        },
        "freshness": {
          "type": "number",
          "required": true
        },
        "reasons_json": {
          "type": "string",
          "required": true
        },
        "scored_at": {
          "type": "datetime_utc",
          "required": true
        }
      }
