        "company_key": {
          "type": "string|null",
          "required": false
        },
        "match_method": {
          "type": "string",
          "required": true
        },
        "match_status": {
          "type": "string",
          "required": true,
          "values": [
            "matched",
            "ambiguous",
            "unresolved",
            "error"
          ]
