{
  "version": "G8N-012",
  "storage_engine": "n8n_data_tables",
  "sqlite_scope": "n8n embedded SQLite, accessed only through n8n/Data Table nodes",
  "raw_payload_root": "data/raw/{source}/{yyyy-mm-dd}/{run_id}",
  "timestamp_policy": "UTC ISO-8601",
  "relations_policy": "logical identifiers only; no direct SQLite foreign keys",
  "tables": [
    {
      "name": "ingestion_runs",
      "upsert_key": "run_id",
      "columns": {
        "run_id": {
          "type": "string",
          "required": true
        },
        "source": {
          "type": "string",
          "required": true
        },
        "status": {
          "type": "string",
          "required": true,
          "values": [
            "started",
            "partial",
            "completed",
            "failed",
            "cancelled"
          ]
        },
        "started_at": {
          "type": "datetime_utc",
          "required": true
        },
        "completed_at": {
          "type": "datetime_utc|null",
          "required": false
        },
        "schema_version": {
          "type": "string",
          "required": true
        },
        "input_config_hash": {
          "type": "string",
          "required": true
        },
        "raw_root_path": {
          "type": "string",
          "required": true
        },
        "source_window_start_utc": {
          "type": "datetime_utc|null",
          "required": false
        },
        "source_window_end_utc": {
          "type": "datetime_utc|null",
          "required": false
        },
        "config_version": {
          "type": "string|null",
          "required": false
        },
        "checkpoint_json": {
          "type": "string|null",
          "required": false
        },
        "counters_json": {
          "type": "string|null",
          "required": false
        },
        "notes": {
          "type": "string|null",
          "required": false
        }
      }
    },
    {
      "name": "raw_job_offers",
      "upsert_key": "raw_offer_key",
      "columns": {
        "raw_offer_key": {
          "type": "string",
          "required": true,
          "example": "france_travail:FT-123456"
        },
        "run_id": {
          "type": "string",
          "required": true
        },
        "source": {
          "type": "string",
          "required": true
        },
        "source_offer_id": {
          "type": "string|null",
          "required": false
        },
        "raw_path": {
          "type": "string",
          "required": true
        },
        "raw_page_path": {
          "type": "string|null",
          "required": false
        },
        "source_page_range": {
          "type": "string|null",
          "required": false
        },
        "page_index": {
          "type": "integer|null",
          "required": false
        },
        "payload_hash": {
          "type": "string",
          "required": true
        },
        "collected_at": {
          "type": "datetime_utc",
          "required": true
        },
        "first_seen_at": {
          "type": "datetime_utc",
          "required": true
        },
        "last_seen_at": {
          "type": "datetime_utc",
          "required": true
        },
        "payload_status": {
          "type": "string",
          "required": true,
          "values": [
            "new",
            "unchanged",
            "updated"
          ]
        },
        "source_updated_at": {
          "type": "datetime_utc|null",
          "required": false
        }
      }
    },
    {
      "name": "job_offers",
      "upsert_key": "offer_key",
      "columns": {
        "offer_key": {
          "type": "string",
          "required": true
        },
        "raw_offer_key": {
          "type": "string",
          "required": true
        },
        "source": {
          "type": "string",
          "required": true
        },
        "source_offer_id": {
          "type": "string|null",
          "required": false
        },
        "dedupe_fingerprint": {
          "type": "string",
          "required": true
        },
        "company_key": {
          "type": "string|null",
          "required": false
        },
        "company_name": {
          "type": "string|null",
          "required": false
        },
        "title": {
          "type": "string",
          "required": true
        },
        "normalized_title": {
          "type": "string",
          "required": true
        },
        "description_excerpt": {
          "type": "string|null",
          "required": false
        },
        "job_family": {
          "type": "string|null",
          "required": false
        },
        "contract_type": {
          "type": "string|null",
          "required": false
        },
        "declared_positions": {
          "type": "integer|null",
          "required": false
        },
        "location_label": {
          "type": "string|null",
          "required": false
        },
        "postal_code": {
          "type": "string|null",
          "required": false
        },
        "city": {
          "type": "string|null",
          "required": false
        },
        "location_country": {
          "type": "string|null",
          "required": false
        },
        "declared_company_name": {
          "type": "string|null",
          "required": false
        },
        "published_at": {
          "type": "datetime_utc|null",
          "required": false
        },
        "normalize_version": {
          "type": "string",
          "required": true
        },
        "normalization_status": {
          "type": "string",
          "required": true,
          "values": [
            "valid",
            "needs_review",
            "rejected"
          ]
        },
        "normalization_reasons_json": {
          "type": "string",
          "required": true
        },
        "quality_json": {
          "type": "string",
          "required": true
        },
        "status": {
          "type": "string",
          "required": true,
          "values": [
            "active",
            "expired",
            "duplicate",
            "republication",
            "rejected"
          ]
        },
        "updated_at": {
          "type": "datetime_utc",
          "required": true
        },
        "first_seen_at": {
          "type": "datetime_utc|null",
          "required": false
        },
        "last_seen_at": {
          "type": "datetime_utc|null",
          "required": false
        },
        "canonical_offer_key": {
          "type": "string|null",
          "required": false
        },
        "republication_group_key": {
          "type": "string|null",
          "required": false
        },
        "duplicate_of_offer_key": {
          "type": "string|null",
          "required": false
        },
        "dedupe_status": {
          "type": "string",
          "required": true,
          "values": [
            "new",
            "updated",
            "duplicate",
            "republication"
          ]
        },
        "dedupe_reasons_json": {
          "type": "string",
          "required": true
        },
        "dedupe_confidence": {
          "type": "number",
          "required": true
        }
      }
    },
    {
      "name": "companies",
      "upsert_key": "company_key",
      "columns": {
        "company_key": {
