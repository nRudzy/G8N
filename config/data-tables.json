        },
        "siret_headquarters": {
          "type": "string|null",
          "required": false
        },
        "legal_name": {
          "type": "string|null",
          "required": false
        },
        "naf_code": {
          "type": "string|null",
          "required": false
        },
        "employee_band": {
          "type": "string|null",
          "required": false
        },
        "identity_confidence": {
          "type": "number",
          "required": true
        },
        "updated_at": {
          "type": "datetime_utc",
          "required": true
        }
      }
    },
    {
      "name": "company_matches",
      "upsert_key": "match_key",
      "columns": {
        "match_key": {
          "type": "string",
          "required": true
        },
        "offer_key": {
          "type": "string",
          "required": true
