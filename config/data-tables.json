        "confidence": {
          "type": "number",
          "required": true
        },
        "reason": {
          "type": "string",
          "required": true
        },
        "match_rule_version": {
          "type": "string",
          "required": true
        },
        "declared_company_name": {
          "type": "string|null",
          "required": false
        },
        "declared_city": {
          "type": "string|null",
          "required": false
        },
        "declared_postal_code": {
          "type": "string|null",
          "required": false
        },
        "candidate_siren": {
          "type": "string|null",
          "required": false
        },
        "candidate_siret": {
          "type": "string|null",
          "required": false
        },
        "evidence_json": {
          "type": "string",
          "required": true
        },
        "updated_at": {
          "type": "datetime_utc",
          "required": true
        }
      }
    },
    {
      "name": "company_enrichments",
      "upsert_key": "enrichment_key",
      "columns": {
        "enrichment_key": {
          "type": "string",
          "required": true
        },
        "company_key": {
          "type": "string",
          "required": true
        },
        "enrichment_source": {
          "type": "string",
          "required": true
        },
        "payload_path": {
          "type": "string|null",
          "required": false
        },
        "payload_hash": {
          "type": "string|null",
          "required": false
        },
        "legal_status": {
