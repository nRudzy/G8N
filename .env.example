# Copy this file to .env before starting the stack.
# Generate a unique value locally; never commit the resulting .env file.
N8N_ENCRYPTION_KEY=replace-with-a-long-random-local-value

# The published port stays bound to 127.0.0.1 by docker-compose.yml.
N8N_PORT=5678

# UI scheduling uses Europe/Paris. Business timestamps must be stored as UTC.
TZ=Europe/Paris
GENERIC_TIMEZONE=Europe/Paris

# Execution retention. Values are hours/counts; defaults favor short local retention.
EXECUTIONS_DATA_SAVE_ON_ERROR=all
EXECUTIONS_DATA_SAVE_ON_SUCCESS=none
EXECUTIONS_DATA_SAVE_MANUAL_EXECUTIONS=true
EXECUTIONS_DATA_MAX_AGE=168
EXECUTIONS_DATA_PRUNE_MAX_COUNT=10000

# Keep normal logs concise. Never enable debug logs when handling real credentials
# unless the output is reviewed and deleted locally afterwards.
N8N_LOG_LEVEL=info

# Policy values used by the documented manual purge until a dedicated workflow
# implements automated lifecycle management.
G8N_RAW_RETENTION_DAYS=30
G8N_EXPORT_RETENTION_DAYS=30
