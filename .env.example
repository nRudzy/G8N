# Copy this file to .env before starting the stack.
# Generate a unique value locally; never commit the resulting .env file.
N8N_ENCRYPTION_KEY=replace-with-a-long-random-local-value

# The published port stays bound to 127.0.0.1 by docker-compose.yml.
N8N_PORT=5678

# UI scheduling uses Europe/Paris. Business timestamps must be stored as UTC.
TZ=Europe/Paris
GENERIC_TIMEZONE=Europe/Paris
